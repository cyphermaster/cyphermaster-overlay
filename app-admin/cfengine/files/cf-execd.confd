# /etc/conf.d/cf-execd

# Service supervisor: unset for start-stop-daemon (no respawn), or
# supervise-daemon (respawns the daemon after respawn_delay seconds).
#supervisor="supervise-daemon"
#respawn_delay=10

# Extra options passed to cf-execd (--no-fork is always set).
# See cf-execd --help.
#EXTRA_OPTS="--inform"
