# /etc/conf.d/cf-monitord

# Service supervisor: unset for start-stop-daemon (no respawn), or
# supervise-daemon (respawns the daemon after respawn_delay seconds).
#supervisor="supervise-daemon"
#respawn_delay=10

# Extra options passed to cf-monitord (--no-fork is always set).
# See cf-monitord --help.
#EXTRA_OPTS="--inform"
