#!/sbin/openrc-run
# shellcheck shell=sh

name="vmalert daemon"
description="VictoriaMetrics alerting and recording rules engine"

: "${VMALERT_BIN:=/opt/victoriametrics/bin/vmalert}"
: "${VMALERT_USER:=victoria-metrics}"
: "${VMALERT_GROUP:=victoria-metrics}"
: "${VMALERT_RULES:=/etc/victoria-metrics/vmalert/*.yml}"
: "${VMALERT_DATASOURCE:=http://127.0.0.1:8428}"
: "${VMALERT_LISTEN:=:8880}"
: "${VMALERT_LOGFILE:=/var/log/vmalert.log}"
: "${VMALERT_NOFILE:=65536}"

command="${VMALERT_BIN}"
# quotes: the glob must reach vmalert unexpanded
command_args="
	-rule='${VMALERT_RULES}'
	-datasource.url=${VMALERT_DATASOURCE}
	-httpListenAddr=${VMALERT_LISTEN}
	${VMALERT_NOTIFIER:+-notifier.url=${VMALERT_NOTIFIER}}
	${VMALERT_OPTS}"
command_user="${VMALERT_USER}:${VMALERT_GROUP}"
command_background="yes"

pidfile="/run/${RC_SVCNAME}.pid"
output_log="${VMALERT_LOGFILE}"
error_log="${VMALERT_LOGFILE}"
rc_ulimit="-n ${VMALERT_NOFILE}"
stopsig="SIGINT"
retry="SIGINT/30/SIGTERM/10/SIGKILL/5"

extra_started_commands="reload"

depend() {
	need localmount
	use net
	after victoriametrics
}

start_pre() {
	[ -x "${VMALERT_BIN}" ] || { eerror "${VMALERT_BIN} introuvable ou non exécutable"; return 1; }

	checkpath -f -m 0640 -o "${VMALERT_USER}:${VMALERT_GROUP}" "${VMALERT_LOGFILE}" || return 1
	return 0
}

reload() {
	ebegin "Reloading ${RC_SVCNAME} rules"
	start-stop-daemon --signal SIGHUP --pidfile "${pidfile}"
	eend $?
}
